# Configuration de l'environnement Cantine Manager Backend
# Note : Ne jamais stocker de valeurs de production réelles dans ce fichier d'exemple.

# Port d'écoute du serveur HTTP
PORT=5000

# Environnement d'exécution (development | production | test)
NODE_ENV=development

# Chaîne de connexion à la base de données MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/cantine_manager

# Clé secrète pour la signature des jetons JWT (utiliser une clé d'au moins 64 caractères aléatoires en production)
JWT_SECRET=votre_cle_secrete_ultra_securisee_pour_cantine_manager_2026

# Durée de validité des jetons d'authentification JWT
JWT_EXPIRES_IN=8h

# Origines autorisées pour les requêtes CORS (séparées par une virgule)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

